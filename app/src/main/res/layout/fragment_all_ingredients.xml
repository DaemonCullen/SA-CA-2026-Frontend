<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorPrimary"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All Ingredients"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Search and filter ingredients"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Search and Filter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/background">

        <SearchView
            android:id="@+id/ingredientSearchView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:queryHint="Search ingredients..."
            />

        <Spinner
            android:id="@+id/ingredientFilterSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Quick Filter Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        android:background="@color/background">

        <Button
            android:id="@+id/btnCheapIngredients"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Cheap"
            android:textSize="11sp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="4dp"
            android:backgroundTint="#4CAF50" />

        <Button
            android:id="@+id/btnHighProtein"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="High Protein"
            android:textSize="11sp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="4dp"
            android:backgroundTint="#FF9800" />

        <Button
            android:id="@+id/btnLowFat"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Low Fat"
            android:textSize="11sp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="4dp"
            android:backgroundTint="#2196F3" />
    </LinearLayout>

    <!-- Ingredients List -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <ListView
            android:id="@+id/ingredientsListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#EEE"
            android:dividerHeight="1dp"
            android:background="@color/card_background" />

    </androidx.cardview.widget.CardView>

</LinearLayout>