<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/meals_filter_category"
        android:textStyle="bold"
        android:textSize="16sp" />

    <Spinner
        android:id="@+id/filterCategorySpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/meals_filter_difficulty"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="16dp" />

    <Spinner
        android:id="@+id/filterDifficultySpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/meals_filter_minProtein"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/filterProteinInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/meals_filter_minProtein_example"
        android:inputType="numberDecimal"
        android:layout_marginTop="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/meals_filter_maxCalories"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/filterCaloriesInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/meals_filter_maxCalories_example"
        android:inputType="numberDecimal"
        android:layout_marginTop="6dp" />

</LinearLayout>