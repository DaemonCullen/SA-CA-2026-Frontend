<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meals_filter_category"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/filterCategorySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meals_filter_difficulty"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />

        <Spinner
            android:id="@+id/filterDifficultySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meals_filter_proteinRange"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/textProteinRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meals_filter_proteinRangeValue"
            android:layout_marginTop="4dp" />

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/proteinRangeSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            app:values="@array/default_protein_range" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meals_filter_caloriesRange"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/textCaloriesRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meals_filter_caloriesRangeValue"
            android:layout_marginTop="4dp" />

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/caloriesRangeSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="2000"
            android:stepSize="10"
            app:values="@array/default_calories_range" />

    </LinearLayout>
</ScrollView>